APP_ENV=development
DATABASE_URL=sqlite:///./vision_vitals.db
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
POSTGRES_PASSWORD=replace-with-a-database-password-for-docker
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
GEMINI_API_KEY=
AI_PROVIDER=mock
GEMINI_MODEL=gemini-2.5-flash
MAX_UPLOAD_SIZE_MB=10
STORAGE_PATH=./storage
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://vision-vitals-front-end.vercel.app
TRUSTED_HOSTS=localhost,127.0.0.1,vision-vitals-main-backend.onrender.com
LOG_LEVEL=INFO
DEVICE_AUTH_ENABLED=true
DEVICE_SESSION_EXPIRE_MINUTES=60
DEVICE_HEARTBEAT_TIMEOUT_SECONDS=300
DEVICE_CAPTURE_RATE_LIMIT=12
DEVICE_SENSOR_RATE_LIMIT=60
DEVICE_AUTH_RATE_LIMIT=10
DEVICE_REGISTRATION_RATE_LIMIT=5
DEVICE_HEARTBEAT_RATE_LIMIT=30
AUTH_LOGIN_RATE_LIMIT=10
AUTH_REGISTRATION_RATE_LIMIT=5
AUTH_REFRESH_RATE_LIMIT=20
PASSWORD_RATE_LIMIT=5
APP_CAPTURE_RATE_LIMIT=3
DEVICE_MIN_IMAGE_WIDTH=8
DEVICE_MIN_IMAGE_HEIGHT=8
DEVICE_MIN_SHARPNESS=0
MAX_IMAGE_WIDTH=8192
MAX_IMAGE_HEIGHT=8192
MAX_IMAGE_PIXELS=40000000

# Optional settings for the Python hardware/device client in device/config.py.
# These are not required by the backend API process itself.
VISION_VITALS_BACKEND_URL=http://localhost:8000
VISION_VITALS_DEVICE_IDENTIFIER=replace-with-a-stable-device-identifier
VISION_VITALS_DEVICE_NAME=Vision Vitals Camera
VISION_VITALS_DEVICE_TYPE=VISION_VITALS_CAMERA
VISION_VITALS_CAMERA_WIDTH=1280
VISION_VITALS_CAMERA_HEIGHT=720
VISION_VITALS_IMAGE_FORMAT=jpeg
VISION_VITALS_CAPTURE_TIMEOUT=10
VISION_VITALS_MAX_IMAGE_BYTES=10485760
VISION_VITALS_MAX_RETRIES=3
